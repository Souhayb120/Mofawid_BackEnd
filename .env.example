# Modèle de configuration Mofawid — copier vers .env pour un lancement local
# (le .env réel est ignoré par git). En production sur Render, définir ces
# mêmes noms de variables dans les "Environment" du service ; les variables
# d'environnement priment toujours sur le .env.

# --- Base de données (optionnel en local : MySQL 3307 en secours) ---
# DATA_SOURCE_URL=jdbc:mysql://localhost:3307/mofawid_db?createDatabaseIfNotExist=true
# DATA_SOURCE_USERNAME=root
# DB_PASSWORD=

# --- Google Gemini (obligatoire) ---
GEMINI_API_KEY=
CHAT_MODEL=google-genai
CHAT_MODEL_VERSION=gemini-2.5-flash

# --- Sécrets (obligatoires) ---
JWT_SECRET=
TRACKING_SECRET=
